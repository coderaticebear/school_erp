APP_NAME="School ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One file per day, kept for LOG_DAILY_DAYS. Personal data is masked before it is written.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=school_erp
# The running app: row access only. Created by `php artisan db:provision-roles`.
DB_USERNAME=school_app
DB_PASSWORD=change-me-app
# Schema owner, used only by migrations: `php artisan migrate --database=pgsql_migrations`.
DB_MIGRATION_USERNAME=school_owner
DB_MIGRATION_PASSWORD=change-me-owner
# Server administrator (Sail's Postgres superuser). Only db:provision-roles uses it.
DB_ADMIN_USERNAME=sail
DB_ADMIN_PASSWORD=password

# pgAdmin container (http://localhost:5050)
PG_ADMIN_USERNAME=admin@example.com
PG_ADMIN_PASSWORD=change-me

# School settings (see config/school.php)
SCHOOL_NAME="School ERP"
# SCHOOL_INITIALS=SE   # optional; derived from SCHOOL_NAME when unset
# ISO weekdays the timetable covers: 1 = Monday ... 7 = Sunday
SCHOOL_DAYS=1,2,3,4,5,6
TIMETABLE_MAX_SUBJECT_PER_DAY=2
TIMETABLE_ATTEMPTS=40
LOW_ATTENDANCE_PERCENT=75

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailpit (http://localhost:8025). Never use the log mailer outside local development.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
