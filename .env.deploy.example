# Secrets for the deploy step only (copy to .env.deploy on the server; chmod 600). Never commit the real file.
# Read by the pgsql service and the one-off `tools` service, never by the running app.

# Postgres superuser, created on the first start of the pgsql volume.
POSTGRES_DB=school_erp
POSTGRES_USER=sail
POSTGRES_PASSWORD=CHANGE-ME

# db:provision-roles signs in with these (must match the POSTGRES_* values above).
DB_ADMIN_USERNAME=sail
DB_ADMIN_PASSWORD=CHANGE-ME

# Schema owner used by migrations.
DB_MIGRATION_USERNAME=school_owner
DB_MIGRATION_PASSWORD=CHANGE-ME

# S3 bucket for scripts/backup.sh
BACKUP_BUCKET=CHANGE-ME-school-erp-backups
